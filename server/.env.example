# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgres://kerava:kerava@localhost:5432/kerava
PORT=8787
# Comma separated list of allowed browser origins for cookies and WebSocket.
ALLOWED_ORIGINS=http://localhost:5173
# Set to true behind HTTPS in production.
COOKIE_SECURE=false
# World name and capacity (docs/MULTIPLAYER.md section 6.1).
WORLD_NAME=Kerava 1
MAX_PLAYERS=20
MAX_QUEUE=50
